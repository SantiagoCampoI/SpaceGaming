# Copia este archivo como ".env" y pon tus datos de Supabase
# (Supabase -> Project Settings -> API / Data API).
# El archivo .env NO se sube a GitHub (está en .gitignore).

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# La llave "anon" o "publishable". Es pública a propósito; la protección la dan las reglas RLS.
VITE_SUPABASE_ANON_KEY=pega-aqui-la-llave-anon

# NUNCA pongas aquí la llave "service_role" / "secret".
